[Unit]
Description=CrossDeviceTracker Linux client - foreground screen time tracking
Documentation=https://github.com/Harshit4847/CrossDeviceTracker.Api
# Only start once the graphical session is up (needs a display for X11/Wayland).
After=graphical-session.target
PartOf=graphical-session.target
# Skip the service entirely when there is no display at all.
ExecCondition=/bin/sh -c 'test -n "${DISPLAY}${WAYLAND_DISPLAY}"'

[Service]
Type=simple
ExecStart=%h/.local/bin/cdt start
Restart=on-failure
RestartSec=15
# The tracker must survive an empty environment: point it at the user session.
Environment=CDT_API_URL=http://localhost:5148
Environment=PYTHONUNBUFFERED=1
# Keep I/O low priority so tracking never competes with the user's work.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crossdevicetracker

[Install]
WantedBy=graphical-session.target
